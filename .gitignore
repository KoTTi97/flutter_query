/query/
node_modules
.DS_Store

.dart_tool/
build/
.packages
pubspec_overrides.yaml
# The binding's example is outside the workspace (it ships, and a published
# example cannot say `resolution: workspace`); its override onto the checkout
# is committed, and kept out of the archive by packages/query_kit_flutter/.pubignore.
!/packages/query_kit_flutter/example/pubspec_overrides.yaml
/packages/query_kit_flutter/example/pubspec.lock

# dart doc output
**/doc/api/

# competitor checkouts read by docs/research/competitor-deep-dive.md
/reference-projects/

# the documentation site's generated cache (its `build/` is covered above)
/website/.docusaurus/

# the site's live demos: web builds of the examples, written by
# tool/build_demos.sh (`npm run demos`) and never committed
/website/static/demo/

# the site's end-to-end suite's output
/website/e2e/test-results/
/website/e2e/playwright-report/

# scratch worktrees the agent tooling creates
/.claude/worktrees/

# review write-ups: session artefacts, not repository content
/docs/reviews/

# throwaway probe tests review sessions leave behind (`_<name>_tmp_test.dart`):
# ignored, so neither `git status` nor a pub archive ever picks one up
/packages/*/test/_*_tmp_test.dart
