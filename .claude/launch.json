{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "react-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "react-demo/react",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "showcase-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "examples/showcase/server",
        "start"
      ],
      "port": 5175
    },
    {
      "name": "showcase-web",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "examples/showcase/e2e/serve.mjs",
        "examples/showcase/build/web"
      ],
      "port": 8124
    }
  ]
}
