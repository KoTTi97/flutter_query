{
  // Node runs these files directly by stripping types — there is no build step.
  // erasableSyntaxOnly rejects the syntax stripping can't handle (enums,
  // parameter properties), which is what keeps `node server.ts` working.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "rootDir": "./",
    "noEmit": true,

    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,

    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["*.ts"]
}
